// Data width
`define DWIDTH 32

// Word size - don't change to anything but 32
`define WWIDTH 32

// Immediate value width (for immediate instructions)
// Generally, they are 8 bits. But they can also be 12 or 24 bits, which is fun
`define IMM_WIDTH 8

// Address width
`define AWIDTH 8

// Instruction width
`define IWIDTH 32