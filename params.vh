// Data width — needs to be 64 bit for dual load/store operations
`define DWIDTH = 64;

// Word size - don't change to anything but 32
`define WWIDTH = 32;

// Immediate value width (for immediate instructions)
`define IMM_WIDTH = 12;

// Address width
`define AWIDTH = 8;

// Instruction width
`define IWIDTH = 32;